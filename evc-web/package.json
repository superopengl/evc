  "scripts": {
    "start": "cross-env REACT_APP_GIT_HASH=$(git rev-parse --short HEAD) vite",
    "build": "pnpm clean && cross-env GENERATE_SOURCEMAP=true vite build",
    "build:prod": "pnpm clean && pnpm compile",
    "compile": "pnpm clean && cross-env REACT_APP_GIT_HASH=$(git rev-parse --short HEAD) vite build",
    "compile:prod": "pnpm clean && vite build",
    "clean": "rm -rf build",
    "dev": "pnpm i && pnpm build && pnpm start",
    "g": "pnpx generate-react-cli component --",
    "p": "pnpx generate-react-cli component -- --type=page",
    "upload": " aws s3 sync build s3://evc-web/",
    "analyze": "pnpm build; pnpx source-map-explorer 'build/assets/*.js'",
    "preview": "vite preview --port 6007"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^7.0.3",
    "less": "^4.9.0",
    "prop-types": "^15.7.2",
    "source-map-explorer": "^2.5.2",
    "vite": "^8.2.2"
  }
}
